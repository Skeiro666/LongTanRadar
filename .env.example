# ===== 云端 — AI 圆桌 / Council =====
# 硅基流动 / 百炼：一个 Key + 一个 URL，各角色只换 model 名
AI_API_KEY=sk-你的密钥
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_PROVIDER=siliconflow
AI_MODEL=deepseek-ai/DeepSeek-V4-Flash

AI_MODEL_DRAGON=Qwen/Qwen3.5-122B-A10B
AI_MODEL_EVENT=deepseek-ai/DeepSeek-V4-Flash
AI_MODEL_RISK=Pro/moonshotai/Kimi-K2.6
AI_MODEL_CHAIR=deepseek-ai/DeepSeek-V4-Flash

# 阿里云百炼示例：
# AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_PROVIDER=qwen

# ===== 本地 — 新闻智能引擎（Ollama / vLLM / LM Studio）=====
# 与 Council 完全分离；规则映射失败时做低置信 LLM 推断（硬顶 0.45）
NEWS_AI_API_KEY=local
NEWS_AI_BASE_URL=http://127.0.0.1:11434/v1
NEWS_AI_PROVIDER=local
NEWS_AI_MODEL=qwen3.5:4b
NEWS_AI_LLM_MAPPING=true

DATABASE_URL=postgresql+psycopg://postgres:你的密码@127.0.0.1:5432/ashare
REDIS_URL=redis://127.0.0.1:6379/0
BROKER_MODE=paper
