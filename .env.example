# 本地 / 私有模型（Ollama、vLLM、LM Studio 等 OpenAI 兼容端点）
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_PROVIDER=local
# AI_MODEL=llama3.2
# AI_MODEL_DRAGON=llama3.2
# AI_MODEL_EVENT=llama3.2
# AI_MODEL_RISK=llama3.2
# AI_MODEL_CHAIR=llama3.2
# 本地端点通常无需真实 Key，占位即可：
# AI_API_KEY=local

# 云端示例（硅基流动 / 百炼）— 见上方默认配置
AI_API_KEY=sk-你的密钥
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_PROVIDER=siliconflow
AI_MODEL=deepseek-ai/DeepSeek-V4-Flash

AI_MODEL_DRAGON=Qwen/Qwen3.5-122B-A10B
AI_MODEL_EVENT=deepseek-ai/DeepSeek-V4-Flash
AI_MODEL_RISK=Pro/moonshotai/Kimi-K2.6
AI_MODEL_CHAIR=deepseek-ai/DeepSeek-V4-Flash

# 阿里云百炼示例：
# AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_PROVIDER=qwen
# AI_MODEL_DRAGON=qwen3.8-max

